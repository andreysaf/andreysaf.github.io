---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import { getPosts, postUrl, ogUrl, readingMinutes, wordCount, type Post } from '../../lib/posts';
import { SITE, OPENSTRATA, OPENCOMMUNITY } from '../../data/site';
import { faqNode } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const url = new URL(postUrl(post), SITE.url).toString();
// Social cards always use the generated 1200x630 image; heroImage is only shown in-page.
const image = ogUrl(post);
const fmt = (date: Date) => date.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const iso = (date: Date) => date.toISOString().slice(0, 10);

const article = {
  '@type': 'BlogPosting',
  '@id': `${url}#article`,
  headline: d.title,
  description: d.description,
  abstract: d.tldr,
  url,
  mainEntityOfPage: url,
  image: new URL(image, SITE.url).toString(),
  datePublished: iso(d.pubDate),
  dateModified: iso(d.updatedDate ?? d.pubDate),
  author: { '@id': `${SITE.url}/#person` },
  publisher: { '@id': `${SITE.url}/#person` },
  keywords: d.tags.join(', '),
  inLanguage: 'en-CA',
  wordCount: wordCount(post.body),
  isPartOf: { '@id': `${SITE.url}/blog#blog` },
};

---

<Base
  title={d.title}
  description={d.description}
  image={image}
  canonical={d.canonical}
  type="article"
  publishedTime={d.pubDate}
  modifiedTime={d.updatedDate}
  breadcrumbs={[{ name: 'Writing', path: '/blog' }, { name: d.title, path: postUrl(post) }]}
  jsonLd={[article, { '@type': 'Blog', '@id': `${SITE.url}/blog#blog`, name: `${SITE.name}: Writing`, url: `${SITE.url}/blog` }, ...(d.faq.length ? [faqNode(d.faq)] : [])]}
>
  <article class="pt-12" aria-labelledby="post-title">
    <nav aria-label="Breadcrumb" class="text-[0.9rem]">
      <ol class="flex gap-2 text-muted">
        <li><a href="/">Home</a> <span aria-hidden="true">/</span></li>
        <li><a href="/blog">Writing</a></li>
      </ol>
    </nav>
    <header class="mt-6">
      <h1 id="post-title" class="page-title">{d.title}</h1>
      <p class="mt-3 text-[0.9rem] text-muted">
        By <a href="/about" rel="author">Andrey Safonov</a>{', '}
        <time datetime={iso(d.pubDate)}>{fmt(d.pubDate)}</time>
        {d.updatedDate && <>{', updated '}<time datetime={iso(d.updatedDate)}>{fmt(d.updatedDate)}</time></>}
        {`. About ${readingMinutes(post.body)} minute${readingMinutes(post.body) === 1 ? '' : 's'} to read.`}
      </p>
    </header>

    {d.tldr && (
      <section class="mt-8 border-l-2 border-rule pl-5" aria-labelledby="summary">
        <h2 id="summary" class="text-lg font-bold">Summary</h2>
        <p class="mt-1">{d.tldr}</p>
      </section>
    )}

    {d.heroImage && (
      <img src={d.heroImage} alt={d.heroAlt ?? ''} class="mt-8 w-full" width="1200" height="630" />
    )}

    <div class="prose mt-8 max-w-none">
      <Content />
    </div>

    <Faq faq={d.faq} />

    <footer class="section">
      <p>
        <a href="/about">Andrey Safonov</a> is the founder of <a href="https://solunar.ca">Solunar</a>, which builds{' '}
        <a href={OPENSTRATA.url}>OpenStrata</a>, strata management software for British Columbia, and{' '}
        <a href={OPENCOMMUNITY.url}>OpenCommunity</a>, member and program management for community organizations.
      </p>
    </footer>
  </article>

  {(newer || older) && (
    <nav class="section" aria-label="More writing">
      <h2 class="section-title">More writing</h2>
      <ul class="mt-2 space-y-2">
        {older && <li>Previous: <a href={postUrl(older)}>{older.data.title}</a></li>}
        {newer && <li>Next: <a href={postUrl(newer)}>{newer.data.title}</a></li>}
      </ul>
    </nav>
  )}
</Base>
