---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getAllCards } from '../../lib/posts';
import { SITE } from '../../data/site';

const cards = await getAllCards();
const byYear = Object.entries(
  cards.reduce<Record<string, typeof cards>>((acc, c) => {
    (acc[c.pubDate.getUTCFullYear()] ??= []).push(c);
    return acc;
  }, {}),
).sort(([a], [b]) => Number(b) - Number(a));
---

<Base
  title="Writing: Product, AI and Building Software for Communities"
  description="Writing by Andrey Safonov on product management, OKRs, AI agents, strata and community software, and lessons from Apryse, Aspire Software and Solunar."
  breadcrumbs={[{ name: 'Writing', path: '/blog' }]}
  jsonLd={[{
    '@type': 'Blog',
    '@id': `${SITE.url}/blog#blog`,
    name: `${SITE.name}: Writing`,
    url: `${SITE.url}/blog`,
    author: { '@id': `${SITE.url}/#person` },
  }]}
>
  <section class="pt-12" aria-labelledby="writing">
    <h1 id="writing" class="page-title">Writing</h1>
    <p class="lede mt-6">
      Notes on product management, AI, and building software for the organizations communities depend on. Posts
      published elsewhere are marked with where they appeared. You can also <a href="/rss.xml">subscribe with RSS</a>.
    </p>
  </section>

  {byYear.map(([year, posts]) => (
    <section class="section" aria-labelledby={`y${year}`}>
      <h2 id={`y${year}`} class="section-title">{year}</h2>
      <div class="mt-2 divide-y divide-rule">
        {posts.map((p) => <PostCard post={p} />)}
      </div>
    </section>
  ))}
</Base>
