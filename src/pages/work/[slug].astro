---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import { PRODUCTS, SOLUNAR, type Product } from '../../data/site';
import { faqNode } from '../../lib/schema';

type Page = {
  title: string;
  description: string;
  problem: string[];
  why: string[];
  faq: { q: string; a: string }[];
  readMore: { href: string; label: string };
};

const PAGES: Record<string, Page> = {
  openstrata: {
    title: 'OpenStrata: Strata Management Software for BC, by Founder Andrey Safonov',
    description:
      'OpenStrata is strata management software for BC councils and residents, covering documents, bylaws, minutes, AGMs and requests. Founder Andrey Safonov on why it exists.',
    problem: [
      'Strata councils in British Columbia are made up of volunteers who govern buildings worth millions of dollars, often with nothing more than an inbox, a shared drive and a binder handed down from the last council.',
      'Residents can’t find bylaws or minutes, so they email the council. The same questions repeat every month, and when council members change, knowledge walks out the door with them.',
    ],
    why: [
      'After a decade of building software for industries around the world, I wanted to focus that experience on the place where I live and the communities I’m part of. Strata buildings are a big part of life in British Columbia, so OpenStrata was a natural place to start.',
      'At Apryse, I spent years building document software used by thousands of organizations. At Aspire, I learned industry after industry by sitting with the people doing the work. OpenStrata combines both: a document-first platform shaped around how BC strata councils actually operate.',
      'It runs in any browser, needs no app, and starts with a council-only pilot. That way a cautious council can try it before involving every owner in the building.',
    ],
    faq: [
      { q: 'What is OpenStrata?', a: 'OpenStrata is web-based strata management software for British Columbia strata corporations. It gives councils a central, searchable home for documents, bylaws, minutes and AGM packages, routes resident requests, and provides self-service answers to residents.' },
      { q: 'Who makes OpenStrata?', a: 'OpenStrata is built by Solunar, a Greater Vancouver software company co-founded by Andrey Safonov.' },
      { q: 'Does OpenStrata replace a property manager?', a: 'No, it doesn’t have to. Self-managed stratas use it to run their building, and professionally managed buildings use it to cut back-and-forth between owners, council and the manager.' },
      { q: 'Do residents need to download an app?', a: 'No. OpenStrata works in any modern web browser on a phone or computer.' },
      { q: 'Can a council pilot OpenStrata first?', a: 'Yes. Councils can start with council members only and invite residents later with guided onboarding.' },
      { q: 'Is OpenStrata available outside BC?', a: 'OpenStrata is designed for British Columbia strata corporations. Visit openstrata.ca for current availability.' },
    ],
    readMore: { href: '/blog/what-bc-strata-councils-need-from-software', label: 'What BC strata councils actually need from software' },
  },
  opencommunity: {
    title: 'OpenCommunity: Member & Program Management for Community Organizations',
    description:
      'OpenCommunity is member and program software for community centres and nonprofits: kiosk sign-in, attendance, scheduling and funder reporting. Founder Andrey Safonov on why.',
    problem: [
      'Community hubs, family centres and nonprofit programs serve whole neighbourhoods, yet many still run on paper sign-in sheets, copied spreadsheets and staff memory.',
      'The pain peaks at reporting time. Funders and boards want unique visitors, demographics and program trends, and producing them by hand takes days of reconciling.',
    ],
    why: [
      'I co-founded Solunar to focus my industry experience on the place where I live and the communities I’m part of. Community centres, drop-in programs and nonprofits are the organizations that hold those communities together, and they deserve modern software.',
      'Across a portfolio of vertical software businesses at Aspire, I saw how much a focused, modern system changes the day for front-line staff. Community organizations deserve that too, at a price that works for nonprofits.',
      'OpenCommunity puts memberships, attendance, kiosk sign-in, scheduling, payments and funder reporting in one place, with role-based access and encryption, because these organizations hold sensitive information about families.',
    ],
    faq: [
      { q: 'What is OpenCommunity?', a: 'OpenCommunity is member and program management software for community hubs, nonprofits and publicly funded organizations. It brings memberships, attendance, kiosk sign-in, scheduling, payment tracking and reporting into one system.' },
      { q: 'Who makes OpenCommunity?', a: 'OpenCommunity is built by Solunar, a Greater Vancouver software company co-founded by Andrey Safonov.' },
      { q: 'How does kiosk sign-in work?', a: 'Visitors sign in at a reception kiosk using a phone number or another chosen field, confirmed by a personal PIN.' },
      { q: 'Does OpenCommunity help with funder reporting?', a: 'Yes. It generates attendance summaries, demographic breakdowns, unique-family counts and program statistics for funders and boards.' },
      { q: 'Can multiple locations use one account?', a: 'Yes. Each centre gets its own programs, staff and kiosk, and reporting rolls up across all locations.' },
      { q: 'Do families need to download an app?', a: 'No. The family portal runs in a web browser.' },
    ],
    readMore: { href: '/blog/community-centre-software-spreadsheets', label: 'Running a community centre on spreadsheets: what breaks first' },
  },
};

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props { product: Product }
const { product: p } = Astro.props;
const page = PAGES[p.slug];
---

<Base
  title={page.title}
  description={page.description}
  image={`/og/${p.slug}.png`}
  breadcrumbs={[{ name: 'Work', path: '/portfolio' }, { name: p.name, path: `/work/${p.slug}` }]}
  jsonLd={[faqNode(page.faq)]}
>
  <article class="pt-12" aria-labelledby="title">
    <p class="meta">Notes from a co-founder of <a href={SOLUNAR.url}>Solunar</a></p>
    <h1 id="title" class="mt-2 page-title">{p.name}</h1>
    <p class="lede mt-3 text-muted">{p.tagline}</p>
    <p class="mt-6">{p.oneLiner}</p>
    <p class="mt-6"><a class="cta" href={p.url}>Visit {p.url.replace('https://', '')}</a></p>

    <section class="section" aria-labelledby="problem">
      <h2 id="problem" class="section-title">The problem</h2>
      <div class="mt-4">{page.problem.map((t) => <p>{t}</p>)}</div>
    </section>

    <section class="section" aria-labelledby="who">
      <h2 id="who" class="section-title">Who {p.name} is for</h2>
      <ul class="mt-3 list-disc space-y-1 pl-5">{p.audience.map((a) => <li>{a}</li>)}</ul>
    </section>

    <section class="section" aria-labelledby="what">
      <h2 id="what" class="section-title">What {p.name} does</h2>
      <ul class="mt-3 list-disc space-y-1 pl-5">{p.features.map((f) => <li>{f}</li>)}</ul>
    </section>

    <section class="section" aria-labelledby="why">
      <h2 id="why" class="section-title">Why I'm building it</h2>
      <div class="mt-3">{page.why.map((t) => <p>{t}</p>)}</div>
    </section>

    <Faq faq={page.faq} />

    <section class="section" aria-labelledby="next">
      <h2 id="next" class="section-title">Try {p.name}</h2>
      <p class="mt-3">Book a short demo or start a pilot.</p>
      <p class="mt-4"><a class="cta" href={p.url}>{p.anchor}</a></p>
      <p class="mt-6">For more background, read <a href={page.readMore.href}>{page.readMore.label}</a>.</p>
    </section>
  </article>
</Base>
