---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import TestimonialQuote from '../components/Testimonial.astro';
import PostCard from '../components/PostCard.astro';
import { SITE, PRODUCTS, SAFAS, SOLUNAR, SOCIAL } from '../data/site';
import { FEATURED } from '../data/testimonials';
import { getAllCards } from '../lib/posts';

const latest = (await getAllCards()).slice(0, 3);

const track = [
  { years: '2023–2026', role: 'Head of Product and Development, AI lead', org: 'Aspire Software', note: 'Led product and AI across a portfolio of vertical software companies and worked with 14 of them, including as chief technology officer of DockMaster, where I built DockMaster Web. Created Signiphi, BluSynq and BluMarina.' },
  { years: '2018–2023', role: 'Head of Product', org: 'Apryse (PDFTron)', note: 'Started as a solutions engineer and became the first product manager. Grew the product portfolio from $5M to more than $50M.' },
  { years: '2015–2018', role: 'Implementation consultant', org: 'Fast Enterprises', note: 'Built the British Columbia Ministry of Finance’s online tax portal.' },
];
---

<Base
  title={SITE.title}
  description={SITE.description}
  type="profile"
  jsonLd={[{ '@type': 'ProfilePage', mainEntity: { '@id': `${SITE.url}/#person` } }]}
>
  <!-- 1. Who I am -->
  <section class="pt-12" aria-labelledby="intro">
    <div class="flex items-center gap-5">
      <img src="/profile.jpg" alt="Portrait of Andrey Safonov" width="80" height="80" class="size-20 shrink-0 rounded-full object-cover" fetchpriority="high" />
      <div>
        <h1 id="intro" class="page-title">Andrey Safonov</h1>
        <p class="meta mt-1">Founder of Solunar · Product builder · Vancouver, British Columbia</p>
      </div>
    </div>
    <p class="lede mt-8">
      I build software for the organizations communities depend on: strata councils, community centres and nonprofits.
    </p>
    <p class="mt-4">
      Over the past decade I've led product at Apryse and Aspire Software, taking products from idea to millions in revenue
      across industries around the world. Now I'm focusing that experience on the place where I live and the communities I'm
      part of, building <a href={SOLUNAR.url}>Solunar</a> full time.
    </p>
  </section>

  <!-- 2. What I'm building (primary) -->
  <Section id="now" title="What I'm building">
    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      {PRODUCTS.map((p) => (
        <section class="panel" aria-labelledby={`p-${p.slug}`}>
          <h3 id={`p-${p.slug}`} class="text-xl font-bold">{p.name}</h3>
          <p class="mt-2">{p.short}</p>
          <p class="mt-5"><a class="cta" href={p.url}>Visit {p.url.replace('https://', '')}</a></p>
          <p class="mt-3 text-[0.9rem]"><a href={`/work/${p.slug}`}>Why I'm building {p.name}</a></p>
        </section>
      ))}
    </div>
    <p class="meta mt-6">
      Both are made by <a href={SOLUNAR.url}>Solunar</a>. I also co-founded <a href={SAFAS.url}>SAFAS</a>, which verifies
      that live video on calls comes from real cameras.
    </p>
  </Section>

  <!-- 3. Track record -->
  <Section id="track" title="Track record">
    <dl class="mt-6">
      {track.map((t) => (
        <div class="grid gap-x-6 border-t border-rule py-4 first:border-t-0 first:pt-0 sm:grid-cols-[7rem_1fr]">
          <dt class="meta pt-0.5">{t.years}</dt>
          <dd>
            <p class="font-semibold">{t.role}, {t.org}</p>
            <p class="mt-1">{t.note}</p>
          </dd>
        </div>
      ))}
    </dl>
    <p class="mt-4"><a href="/about#timeline">Full career timeline</a></p>
  </Section>

  <!-- 4. Proof -->
  <Section id="words" title="What people say">
    <div class="mt-6 space-y-8">
      {FEATURED.map((t) => <TestimonialQuote t={t} />)}
    </div>
    <p class="mt-6"><a href="/about#shoutouts">More from customers and colleagues</a></p>
  </Section>

  <!-- 5. Writing -->
  <Section id="writing" title="Recent writing">
    <div class="mt-2 divide-y divide-rule">
      {latest.map((p) => <PostCard post={p} showDescription={false} />)}
    </div>
    <p class="mt-4"><a href="/blog">All writing</a></p>
  </Section>

  <p class="section">
    Want to talk about strata or community software, or product and AI? <a href={SOCIAL.linkedin}>Message me on LinkedIn</a>.
  </p>
</Base>
