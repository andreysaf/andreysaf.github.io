---
import Base from '../layouts/Base.astro';
import TimelineItem from '../components/TimelineItem.astro';
import TestimonialCard from '../components/Testimonial.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Faq from '../components/Faq.astro';
import { PERSON, SITE, OPENSTRATA, OPENCOMMUNITY, SOLUNAR, SOCIAL } from '../data/site';
import { TIMELINE } from '../data/timeline';
import { TESTIMONIALS } from '../data/testimonials';
import { timelineNode, faqNode } from '../lib/schema';

const full = TIMELINE.filter((r) => !r.compact || r.id === 'safas' || r.id === 'blockstream');
const early = TIMELINE.filter((r) => r.compact && !['safas', 'blockstream'].includes(r.id));
const aspire = TESTIMONIALS.filter((t) => t.era === 'aspire' && !t.relatesTo);
const apryse = TESTIMONIALS.filter((t) => t.era === 'apryse');

const faq = [
  { q: 'Who is Andrey Safonov?', a: PERSON.summary },
  {
    q: 'What is Andrey Safonov working on now?',
    a: `He is the founder of Solunar, a Greater Vancouver software company. Solunar builds OpenStrata (${OPENSTRATA.url}), strata management software for British Columbia, and OpenCommunity (${OPENCOMMUNITY.url}), member and program management for community centres, nonprofits and drop-in programs.`,
  },
  {
    q: 'What did Andrey Safonov do at Apryse (PDFTron)?',
    a: 'He joined in 2018 as a Technical Solutions Engineer, became the company’s first Product Manager in 2019, and was Head of Product from 2021 to 2023. He launched 0→1 products including the DOCX Editor and Video Collaboration, opened a low-code channel through Salesforce, Appian and Mendix, and grew the portfolio from $5M to $50M+.',
  },
  {
    q: 'What did Andrey Safonov do at Aspire Software?',
    a: 'From 2023 to 2026 he was Technical Product Manager, then Head of Product & Development and AI Lead, effectively the CTPO. He worked with 14 companies, including DockMaster Software (as CTO), CORE Cashless, H&L POS, RENTALL, S&W Technologies and VisiumKMS. He also created three AI-native products: Signiphi, BluSynq and BluMarina.',
  },
];
---

<Base
  title="About Andrey Safonov: Career Timeline, Work & Testimonials"
  description="Career timeline of Andrey Safonov, founder of Solunar (OpenStrata, OpenCommunity): Aspire Software, DockMaster, Apryse (PDFTron) and more, with stories and testimonials."
  type="profile"
  breadcrumbs={[{ name: 'About', path: '/about' }]}
  jsonLd={[{ '@type': 'ProfilePage', mainEntity: { '@id': `${SITE.url}/#person` } }, timelineNode(), faqNode(faq)]}
>
  <div class="mx-auto max-w-3xl px-4 pt-14 sm:px-6">
    <p class="mb-3 text-sm font-medium text-accent">About</p>
    <h1 class="text-4xl font-bold tracking-tight">Andrey Safonov</h1>
    <p class="mt-5 text-lg leading-relaxed">{PERSON.summary}</p>
    <p class="mt-4 leading-relaxed text-muted">
      I started out writing compilers and real-time editors, built the BC Ministry of Finance's tax portal, and moved into
      product after closing deals as a solutions engineer. Since then I've built 0→1 products, worked with teams in 13 locations around the world, and
      used AI to rebuild software in industries I had to learn from scratch: marinas, attraction parks, car rental, restaurants
      and nuclear safety. Today I'm fully focused on <a href={SOLUNAR.url} class="text-accent underline-offset-4 hover:underline">Solunar</a>,
      building <a href={OPENSTRATA.url} class="text-accent underline-offset-4 hover:underline">{OPENSTRATA.anchor}</a> and{' '}
      <a href={OPENCOMMUNITY.url} class="text-accent underline-offset-4 hover:underline">{OPENCOMMUNITY.anchor}</a>.
    </p>
    <p class="mt-4 text-sm text-muted">Last updated <time datetime="2026-10-21">October 21, 2026</time> · <a href={SOCIAL.linkedin} class="underline-offset-4 hover:underline">LinkedIn</a></p>
  </div>

  <section class="mx-auto mt-16 max-w-3xl px-4 sm:px-6" aria-labelledby="timeline">
    <SectionHeading eyebrow="Timeline" title="Where I've worked" id="timeline" />
    <ol class="relative before:absolute before:bottom-0 before:left-5 before:top-2 before:w-px before:bg-line sm:before:left-[22px]">
      {full.map((r) => <TimelineItem role={r} />)}
    </ol>
    <details class="rounded-2xl border border-line bg-surface p-5">
      <summary class="cursor-pointer font-medium">Early career (2011–2015)</summary>
      <ul class="mt-4 space-y-3 text-[15px]">
        {early.map((r) => (
          <li><span class="font-medium">{r.positions[0].title}, {r.org}</span> <span class="text-muted">({r.location}).</span> {r.highlights?.[0]}</li>
        ))}
      </ul>
    </details>
  </section>

  <section class="mx-auto mt-20 max-w-5xl px-4 sm:px-6" aria-labelledby="shoutouts">
    <SectionHeading eyebrow="Shoutouts" title="What people I've worked with say" id="shoutouts" />
    <h3 class="mb-4 mt-8 text-lg font-semibold">Aspire Software, DockMaster & portfolio</h3>
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {aspire.map((t) => <TestimonialCard t={t} />)}
    </div>
    <h3 class="mb-4 mt-12 text-lg font-semibold">Apryse (PDFTron)</h3>
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {apryse.map((t) => <TestimonialCard t={t} />)}
    </div>
  </section>

  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <Faq faq={faq} />
  </div>
</Base>
