---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import TimelineItem from '../components/TimelineItem.astro';
import TestimonialQuote from '../components/Testimonial.astro';
import Faq from '../components/Faq.astro';
import { PERSON, SITE, OPENSTRATA, OPENCOMMUNITY, SOLUNAR, SOCIAL } from '../data/site';
import { TIMELINE } from '../data/timeline';
import { TESTIMONIALS } from '../data/testimonials';
import { timelineNode, faqNode } from '../lib/schema';

const EARLY = ['mgestyk', 'sidense', 'the-source'];
const main = TIMELINE.filter((r) => !EARLY.includes(r.id));
const early = TIMELINE.filter((r) => EARLY.includes(r.id));
const customers = TESTIMONIALS.filter((t) => t.context === 'customer');
const leadership = TESTIMONIALS.filter((t) => t.context === 'leadership');
const colleagues = TESTIMONIALS.filter((t) => t.context === 'colleague');
const updated = new Date(SITE.profileUpdated).toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const faq = [
  { q: 'Who is Andrey Safonov?', a: PERSON.summary },
  {
    q: 'What is Andrey Safonov working on now?',
    a: `He is a co-founder of Solunar, a software company in Greater Vancouver. Solunar builds OpenStrata (${OPENSTRATA.url}), strata management software for British Columbia, and OpenCommunity (${OPENCOMMUNITY.url}), member and program management for community centres, nonprofits and drop-in programs.`,
  },
  {
    q: 'Why did Andrey Safonov start Solunar?',
    a: 'After a decade of building software for industries around the world, he wanted to focus that experience on the place where he lives and the communities he is part of. Solunar builds software for strata corporations and community organizations in British Columbia.',
  },
  {
    q: 'What did Andrey Safonov build at Apryse (PDFTron)?',
    a: 'From 2018 to 2023 he built document tools that let other software view, edit and sign PDF and Word files, used by thousands of organizations. He started as a solutions engineer, became the company’s first product manager, and later ran the product team. He launched new products including the DOCX Editor and Video Collaboration.',
  },
  {
    q: 'What did Andrey Safonov build at Aspire Software?',
    a: 'From 2023 to 2026 he worked with 14 companies that each make software for one industry, including marinas, theme parks, restaurants, car rental and nuclear safety. He built DockMaster Web for marinas as head of technology at DockMaster, and created three new products: Signiphi, BluSynq and BluMarina.',
  },
];
---

<Base
  title="About Andrey Safonov: My Story and What People Say"
  description="The story of Andrey Safonov, co-founder of Solunar (OpenStrata, OpenCommunity): a decade of building software for industries worldwide, now focused on British Columbia communities."
  type="profile"
  breadcrumbs={[{ name: 'About', path: '/about' }]}
  jsonLd={[{ '@type': 'ProfilePage', dateModified: SITE.profileUpdated, mainEntity: { '@id': `${SITE.url}/#person` } }, timelineNode(), faqNode(faq)]}
>
  <section class="pt-12" aria-labelledby="about">
    <h1 id="about" class="page-title">About Andrey</h1>
    <p class="lede mt-6">
      I'm Andrey, a co-founder of <a href={SOLUNAR.url}>Solunar</a>. I live in Vancouver, and I build software that makes
      life easier for the people who keep our communities running.
    </p>
    <p class="meta mt-4">
      Jump to <a href="#story">my story</a>, <a href="#shoutouts">what people say</a> or{' '}
      <a href="#timeline">career details</a>. Last updated <time datetime={SITE.profileUpdated}>{updated}</time>.
    </p>
  </section>

  <Section id="story" title="My story">
    <h3 class="mt-6 text-lg font-bold">Learning from customers</h3>
    <p class="mt-2">
      I started as a software engineer in Ottawa and Victoria. One of my first big projects was the British Columbia
      Ministry of Finance's online tax portal, which millions of British Columbians rely on. It taught me that good
      software is something people barely notice. It simply works when they need it.
    </p>
    <p>
      In 2018 I joined Apryse in Vancouver as a solutions engineer. My job was to sit with customers, understand what they
      were trying to do, and show them how our tools could help. I loved it, and it led me to become the company's first
      product manager. Over five years we built tools that thousands of organizations, from small startups to Microsoft
      and NASA, use to view, edit and sign documents.
    </p>

    <h3 class="mt-8 text-lg font-bold">One industry at a time</h3>
    <p class="mt-2">
      At Aspire Software, I worked with 14 companies, each making software for one specific industry. One week I was
      learning how a marina books a slip, the next how a theme park reloads a wristband or how a technician logs a
      radiation reading. I came in without assumptions and let customers teach me. That made the software better every
      time.
    </p>
    <p>
      Along the way I built DockMaster Web, so marinas can run from anywhere and boaters can pay and sign online. I also
      created BluSynq, an AI front desk that answers every call, and brought AI into restaurant, car rental and safety
      software so staff spend less time on admin.
    </p>

    <h3 class="mt-8 text-lg font-bold">Bringing it home</h3>
    <p class="mt-2">
      All that work was for customers in other places. I wanted to focus it on the place where I live and the communities
      I'm part of. Strata councils run buildings with volunteers and an inbox. Community centres count visitors on paper
      clipboards. They deserve software that is simple, affordable and built with them.
    </p>
    <p>
      That's why I co-founded <a href={SOLUNAR.url}>Solunar</a>. We build <a href={OPENSTRATA.url}>OpenStrata</a> for
      strata councils and residents, and <a href={OPENCOMMUNITY.url}>OpenCommunity</a> for community centres and
      nonprofits. If that sounds like you, I'd love to <a href={SOCIAL.linkedin}>hear from you</a>.
    </p>
  </Section>

  <Section id="shoutouts" title="What people say">
    <h3 class="mt-8 text-lg font-bold">Customers</h3>
    <div class="mt-4 space-y-8">{customers.map((t) => <TestimonialQuote t={t} size="lg" />)}</div>
    <h3 class="mt-12 text-lg font-bold">Founders I've worked for</h3>
    <div class="mt-4 space-y-8">{leadership.map((t) => <TestimonialQuote t={t} />)}</div>
    <h3 class="mt-12 text-lg font-bold">Colleagues and team members</h3>
    <div class="mt-4 space-y-8">{colleagues.map((t) => <TestimonialQuote t={t} />)}</div>
  </Section>

  <Section id="timeline" title="Career details">
    <p class="mt-3">The full record, most recent first, for anyone who wants the details.</p>
    <div class="mt-6">
      {main.map((r) => <TimelineItem role={r} />)}
      <article class="grid gap-x-6 border-t border-rule py-8 sm:grid-cols-[7rem_1fr]" aria-labelledby="early">
        <p class="meta pt-1 font-semibold">2011–2015</p>
        <div>
          <h3 id="early" class="text-xl font-bold">Early career</h3>
          <ul class="mt-3 list-disc space-y-1.5 pl-5">
            {early.map((r) => <li><span class="font-semibold">{r.positions[0].title}, {r.org}</span>. {r.highlights?.[0]}</li>)}
          </ul>
        </div>
      </article>
    </div>
  </Section>

  <Faq faq={faq} />
</Base>
