---
import Base from '../../layouts/Base.astro';
import { PRODUCTS, SAFAS, SOCIAL } from '../../data/site';

const past = [
  { name: 'SAFAS Secure Stream', desc: SAFAS.oneLiner, href: SAFAS.url, note: 'Co-founder' },
  { name: 'BluSynq', desc: 'An AI front desk for marinas and entertainment parks. It answers calls, texts and email in five languages and books work.', href: 'https://blusynq.com', note: 'Created at Aspire Software' },
  { name: 'DockMaster Web', desc: 'Cloud marina management: CRM, customer portal, online payments, e-signatures, service management and an AI scheduling assistant.', href: 'https://www.dockmaster.com/products/dockmaster-web', note: 'Built as chief technology officer of DockMaster' },
  { name: 'Signiphi', desc: 'Digital signatures for developers and AI agents: send eSignatures or embed signing components in your app.', href: 'https://www.signiphi.ai', note: 'Created at Aspire Software' },
  { name: 'BluMarina', desc: 'Modern, cloud-native marina management built around AI agents.', href: 'https://www.blumarina.com', note: 'Created at Aspire Software' },
  { name: 'WebViewer, a PDF viewer and editor', desc: 'Embeds viewing and annotation of PDFs, Office documents and images in any web app.', href: '/portfolio/webviewer-product', note: 'Apryse' },
  { name: 'DOCX Editor', desc: 'Creates and edits Word documents in the browser without Microsoft Office or a server. Built a $3M pipeline in its first quarter.', href: '/portfolio/docx-product', note: 'Apryse, built from scratch' },
  { name: 'Video Annotation', desc: 'Frame-by-frame feedback on video, plus audio redaction. Reached $1M in annual recurring revenue in its first year.', href: 'https://webviewer-video.web.app/', note: 'Apryse, built from scratch' },
];

const videos = [
  { title: 'DOCX Editor demo', id: '3VY1GMyL0AA' },
  { title: 'DevWeek conference talk comparing PDF software development kits', id: 'rGTrcN69LR8' },
  { title: 'PDF editing release walkthrough', id: 'LG2H1qtJN4c' },
];

const github = [
  { title: 'DocuSign clone', desc: 'A React and Firebase app for requesting signatures, signing documents and applying digital signatures.', href: 'https://github.com/PDFTron/pdftron-sign-app' },
  { title: 'Node.js document REST API', desc: 'Converts Office files and images to PDF, generates thumbnails, and optimizes files for fast rendering.', href: 'https://github.com/andreysaf/nodejs-convert-file-server' },
  { title: 'Document indexing and search', desc: 'Extracts and indexes text from documents, with a React search interface that highlights matches.', href: 'https://github.com/PDFTron/pdftron-document-search' },
];
---

<Base
  title="Work: Products Built by Andrey Safonov"
  description="Products Andrey Safonov has built: OpenStrata, OpenCommunity, DockMaster Web, Signiphi, BluSynq, BluMarina, SAFAS and Apryse WebViewer and DOCX Editor."
  breadcrumbs={[{ name: 'Work', path: '/portfolio' }]}
>
  <section class="pt-12" aria-labelledby="work">
    <h1 id="work" class="page-title">Work</h1>
    <p class="lede mt-6">Products I've built and launched, with talks and open-source projects along the way.</p>
  </section>

  <section class="section" aria-labelledby="now">
    <h2 id="now" class="section-title">At Solunar</h2>
    {PRODUCTS.map((p) => (
      <div class="mt-5">
        <h3 class="text-lg font-bold">{p.name}</h3>
        <p class="mt-1">{p.short}</p>
        <p class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2"><a class="cta" href={p.url}>Visit {p.url.replace('https://', '')}</a> <a href={`/work/${p.slug}`}>Why I'm building {p.name}</a></p>
      </div>
    ))}
  </section>

  <section class="section" aria-labelledby="past">
    <h2 id="past" class="section-title">Earlier products</h2>
    {past.map((p) => (
      <div class="mt-5">
        <h3 class="text-lg font-bold">{p.href ? <a href={p.href} class="heading-link">{p.name}</a> : p.name}</h3>
        <p class="meta">{p.note}</p>
        <p class="mt-1">{p.desc}</p>
      </div>
    ))}
  </section>

  <section class="section" aria-labelledby="videos">
    <h2 id="videos" class="section-title">Talks and demos on YouTube</h2>
    <ul class="mt-3 list-disc space-y-2 pl-5">
      {videos.map((v) => <li><a href={`https://www.youtube.com/watch?v=${v.id}`}>{v.title}</a></li>)}
    </ul>
  </section>

  <section class="section" aria-labelledby="oss">
    <h2 id="oss" class="section-title">Open source</h2>
    {github.map((g) => (
      <div class="mt-5">
        <h3 class="text-lg font-bold"><a href={g.href} class="heading-link">{g.title}</a></h3>
        <p class="mt-1">{g.desc}</p>
      </div>
    ))}
    <p class="mt-6">More projects are on <a href={SOCIAL.github}>my GitHub profile</a>.</p>
  </section>
</Base>
