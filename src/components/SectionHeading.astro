---
interface Props { eyebrow?: string; title: string; id?: string; as?: 'h1' | 'h2' }
const { eyebrow, title, id, as = 'h2' } = Astro.props;
const H = as;
---

<div class="mb-6">
  {eyebrow && <p class="mb-2 text-xs font-semibold uppercase tracking-[0.14em] text-accent">{eyebrow}</p>}
  <H id={id} class="text-2xl font-semibold tracking-tight sm:text-3xl">{title}</H>
  <slot />
</div>
