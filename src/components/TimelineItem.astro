---
import { fmtMonth, roleRange, type Role } from '../data/timeline';

interface Props { role: Role }
const { role } = Astro.props;
const { start, end } = roleRange(role);
const year = (ym?: string) => (ym ? ym.slice(0, 4) : 'Now');
const years = role.undated ? '' : start.slice(0, 4) === year(end) ? year(end) : `${start.slice(0, 4)}–${year(end)}`;
const dates = role.undated ? '' : `${fmtMonth(start)} to ${end ? fmtMonth(end) : 'present'}`;
// Lead with the most senior position's results; earlier positions are listed by title only.
const [current, ...earlier] = role.positions;
const keyResults = current.bullets ?? role.highlights ?? [];
---

<article class="grid gap-x-6 border-t border-rule py-8 first:border-t-0 first:pt-2 sm:grid-cols-[7rem_1fr]" aria-labelledby={`role-${role.id}`} id={role.id}>
  <p class="meta pt-1 font-semibold">{years}</p>
  <div>
    <h3 id={`role-${role.id}`} class="text-xl font-bold leading-snug">{role.org}</h3>
    <p class="mt-1 font-semibold">{current.title}</p>
    <p class="meta">{[dates, role.location].filter(Boolean).join(' · ')}</p>
    <p class="mt-3">{role.context}</p>

    {keyResults.length > 0 && (
      <>
        <h4 class="sr-only">Key results</h4>
        <ul class="mt-3 list-disc space-y-1.5 pl-5">
          {keyResults.map((b) => <li>{b}</li>)}
        </ul>
      </>
    )}

    {earlier.length > 0 && (
      <div class="mt-5">
        <h4 class="font-semibold">Earlier roles at {role.org.split(' (')[0]}</h4>
        <ul class="mt-2 space-y-3">
          {earlier.map((p) => (
            <li>
              <span class="font-semibold">{p.title}</span> <span class="meta">({fmtMonth(p.start)} to {fmtMonth(p.end)})</span>
              {p.bullets && <ul class="mt-1 list-disc space-y-1 pl-5">{p.bullets.map((b) => <li>{b}</li>)}</ul>}
            </li>
          ))}
        </ul>
      </div>
    )}

    {role.ventures && (
      <div class="mt-6">
        <h4 class="font-semibold">Products I created</h4>
        <ul class="mt-2 space-y-2">
          {role.ventures.map((v) => (
            <li>
              <span class="font-semibold">{v.url ? <a href={v.url}>{v.name}</a> : v.name}</span>{' '}
              <span class="meta">({v.industry})</span>. {v.story}
            </li>
          ))}
        </ul>
      </div>
    )}

    {role.portfolio && (
      <details class="mt-6 border-t border-rule pt-2">
        <summary>Portfolio companies I worked with ({role.portfolio.length})</summary>
        <dl class="mt-2">
          {role.portfolio.map((c) => (
            <div class="mt-5">
              <dt>
                <span class="font-semibold">{c.url ? <a href={c.url}>{c.name}</a> : c.name}</span>{' '}
                <span class="meta">{c.industry}{c.role ? `. ${c.role}, ${c.period}` : ''}</span>
              </dt>
              <dd class="mt-1">
                <p>{c.story}</p>
                {c.links && <p class="mt-1">{c.links.map((l, i) => <>{i > 0 && ' · '}<a href={l.href}>Visit {l.label}</a></>)}</p>}
                {c.context && <p class="meta mt-1">{c.context}</p>}
              </dd>
            </div>
          ))}
        </dl>
      </details>
    )}

    {role.links && (
      <ul class="mt-4 flex flex-wrap gap-x-5">
        {role.links.map((l) => <li><a href={l.href} class="inline-block min-h-11 py-2">{l.label}</a></li>)}
      </ul>
    )}
  </div>
</article>
