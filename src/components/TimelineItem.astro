---
import { fmtMonth, roleRange, type Role } from '../data/timeline';
import { TESTIMONIALS } from '../data/testimonials';
import TestimonialCard from './Testimonial.astro';

interface Props { role: Role; condensed?: boolean }
const { role, condensed = false } = Astro.props;
const { start, end } = roleRange(role);
const inline = (name: string) => TESTIMONIALS.filter((t) => t.relatesTo === name);
---

<li class="relative pl-14 sm:pl-16" id={role.id}>
  <span class="absolute left-0 top-0 grid size-10 place-items-center rounded-xl border border-line bg-surface text-xs font-bold text-accent sm:size-11" aria-hidden="true">{role.monogram}</span>
  <div class="pb-10">
    <p class="text-xs text-muted">
      {!role.undated && <><time datetime={start}>{fmtMonth(start)}</time> – {end ? <time datetime={end}>{fmtMonth(end)}</time> : 'Present'} · </>}
      {role.location}
    </p>
    <h3 class="mt-1 text-lg font-semibold leading-snug">
      {role.positions[0].title},{' '}
      {role.orgUrl ? <a href={role.orgUrl} class="text-accent underline-offset-4 hover:underline">{role.org}</a> : role.org}
    </h3>
    <p class="mt-1 text-[15px] text-muted">{role.context}</p>

    {condensed ? (
      role.highlights?.[0] && <p class="mt-2 text-[15px]">{role.highlights[0]}</p>
    ) : (
      <>
        {role.highlights && (
          <ul class="mt-3 list-disc space-y-1.5 pl-5 text-[15px] marker:text-muted">
            {role.highlights.map((h) => <li>{h}</li>)}
          </ul>
        )}

        {role.positions.length > 1 || role.positions[0].bullets ? (
          <ol class="mt-4 space-y-5 border-l border-line pl-5">
            {role.positions.map((p) => (
              <li>
                <p class="font-medium">{p.title}</p>
                <p class="text-xs text-muted">{fmtMonth(p.start)} – {fmtMonth(p.end)}</p>
                {p.bullets && (
                  <ul class="mt-2 list-disc space-y-1.5 pl-5 text-[15px] marker:text-muted">
                    {p.bullets.map((b) => <li>{b}</li>)}
                  </ul>
                )}
              </li>
            ))}
          </ol>
        ) : null}

        {role.ventures && (
          <div class="mt-6">
            <h4 class="mb-3 text-sm font-semibold uppercase tracking-wide text-muted">Ventures I created</h4>
            <div class="grid gap-3 sm:grid-cols-3">
              {role.ventures.map((v) => (
                <div class="rounded-xl border border-line bg-surface p-4">
                  <p class="font-semibold">{v.url ? <a href={v.url} class="hover:text-accent">{v.name}</a> : v.name}</p>
                  <p class="text-xs text-muted">{v.industry} · {v.period}</p>
                  <p class="mt-2 text-sm leading-relaxed">{v.story}</p>
                </div>
              ))}
            </div>
          </div>
        )}

        {role.portfolio && (
          <div class="mt-6">
            <h4 class="mb-3 text-sm font-semibold uppercase tracking-wide text-muted">Portfolio companies</h4>
            <div class="divide-y divide-line rounded-xl border border-line bg-surface">
              {role.portfolio.map((c) => (
                <div class="p-4">
                  <p class="font-semibold">
                    {c.url ? <a href={c.url} class="hover:text-accent">{c.name}</a> : c.name}
                    <span class="font-normal text-muted"> · {c.industry}</span>
                    {c.role && <span class="ml-1 rounded-full bg-accent-soft px-2 py-0.5 text-xs font-medium text-accent">{c.role}{c.period && `, ${c.period}`}</span>}
                  </p>
                  {c.context && <p class="mt-1 text-sm text-muted">{c.context}</p>}
                  <p class="mt-1.5 text-[15px]">{c.story}</p>
                  {inline(c.name).length > 0 && (
                    <div class="mt-3 grid gap-3 sm:grid-cols-2">
                      {inline(c.name).map((t) => <TestimonialCard t={t} />)}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        )}

        {role.links && (
          <p class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm">
            {role.links.map((l) => <a href={l.href} class="text-accent underline-offset-4 hover:underline">{l.label} ↗</a>)}
          </p>
        )}
      </>
    )}
  </div>
</li>
