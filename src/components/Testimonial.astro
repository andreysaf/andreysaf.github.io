---
import type { Testimonial } from '../data/testimonials';
interface Props { t: Testimonial }
const { t } = Astro.props;
---

<figure class="border-l-2 border-rule pl-5">
  <blockquote>
    <p>“{t.quote}”</p>
  </blockquote>
  <figcaption class="mt-2 text-[0.9rem] text-muted">{t.name}, {t.title}</figcaption>
</figure>
