---
import type { Testimonial } from '../data/testimonials';
interface Props { t: Testimonial; size?: 'md' | 'lg' }
const { t, size = 'md' } = Astro.props;
---

<figure class:list={['border-l-4 border-rule', size === 'lg' ? 'pl-6' : 'border-l-2 pl-5']}>
  <blockquote>
    <p class:list={[size === 'lg' && 'text-[1.2rem] leading-relaxed']}>“{t.quote}”</p>
  </blockquote>
  <figcaption class="mt-3">
    <span class="font-semibold">{t.name}</span><span class="meta">, {t.title}</span>
  </figcaption>
</figure>
