---
const links = [
  { href: '/about', label: 'About' },
  { href: '/blog', label: 'Writing' },
  { href: '/portfolio', label: 'Work' },
];
const here = Astro.url.pathname.replace(/\.html$/, '');
const isCurrent = (href: string) => here === href || here.startsWith(`${href}/`);
---

<header class="flex flex-wrap items-baseline justify-between gap-x-6 border-b border-rule py-4">
  <a href="/" class="py-2 font-semibold text-ink no-underline visited:text-ink hover:underline" aria-current={here === '/' || here === '/index' ? 'page' : undefined}>Andrey Safonov</a>
  <nav aria-label="Main">
    <ul class="flex gap-x-5">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class:list={['inline-block min-h-11 min-w-11 py-2', isCurrent(l.href) ? 'font-semibold text-ink visited:text-ink' : 'text-ink visited:text-ink no-underline hover:underline']}
            aria-current={isCurrent(l.href) ? 'page' : undefined}
          >{l.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>
