---
interface Props { faq: { q: string; a: string }[]; title?: string; level?: 'h2' | 'h3' }
const { faq, title = 'Questions and answers', level = 'h2' } = Astro.props;
const H = level;
const Q = level === 'h2' ? 'h3' : 'h4';
---

{faq.length > 0 && (
  <section class="section" aria-labelledby="faq-heading">
    <H id="faq-heading" class="section-title">{title}</H>
    {faq.map((f) => (
      <div class="mt-6">
        <Q class="text-lg font-bold">{f.q}</Q>
        <p class="mt-1">{f.a}</p>
      </div>
    ))}
  </section>
)}
