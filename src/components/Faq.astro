---
interface Props { faq: { q: string; a: string }[]; title?: string }
const { faq, title = 'Frequently asked questions' } = Astro.props;
---

{faq.length > 0 && (
  <section class="mt-14" aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="mb-4 text-2xl font-semibold tracking-tight">{title}</h2>
    <div class="divide-y divide-line rounded-2xl border border-line bg-surface">
      {faq.map((f) => (
        <details class="group p-5">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-medium [&::-webkit-details-marker]:hidden">
            <h3 class="text-base">{f.q}</h3>
            <span class="mt-0.5 text-muted transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 leading-relaxed text-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </section>
)}
