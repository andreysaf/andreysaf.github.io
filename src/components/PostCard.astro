---
export type CardPost = {
  title: string;
  description: string;
  pubDate: Date;
  href: string;
  external?: string; // publisher name when hosted elsewhere
  tags: string[];
};
interface Props { post: CardPost; headingLevel?: 'h2' | 'h3'; showDescription?: boolean }
const { post, headingLevel = 'h3', showDescription = true } = Astro.props;
const H = headingLevel;
const date = post.pubDate.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<article class="py-4">
  <H class="text-base font-semibold leading-snug">
    <a href={post.href} class="heading-link">{post.title}</a>
  </H>
  <p class="mt-1 text-[0.9rem] text-muted">
    <time datetime={post.pubDate.toISOString().slice(0, 10)}>{date}</time>{post.external && <>, published on {post.external}</>}
  </p>
  {showDescription && <p class="mt-1">{post.description}</p>}
</article>
